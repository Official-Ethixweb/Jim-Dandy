# =============================================================================
# Jim Dandy Sewer & Plumbing - environment variables
# =============================================================================
# Copy to `.env` for local development. `.env` is gitignored - never commit it.
# For production, set these in the Vercel dashboard (Project > Settings >
# Environment Variables), NOT in a committed file.
#
# EVERY VARIABLE HERE IS OPTIONAL TODAY. The site builds and runs with none of
# them set: analytics renders nothing, Turnstile is off, and leads fall through
# to the not-yet-wired delivery stub. Each one switches on a feature when set.
#
# -----------------------------------------------------------------------------
# ROTATION - READ BEFORE CHANGING A VALUE IN PRODUCTION
# -----------------------------------------------------------------------------
# PUBLIC_* variables are INLINED INTO THE BUILD by Vite. They are embedded in
# the generated HTML/JS, so they are:
#   - visible to anyone viewing source (never put a secret in a PUBLIC_ var), and
#   - only changeable by REBUILDING. Editing the value in the Vercel dashboard
#     does nothing until you trigger a new deployment.
#
# Non-PUBLIC secrets (TURNSTILE_SECRET) are read from process.env at REQUEST
# time and are deliberately NOT baked into the build output - verified by
# grepping .vercel/output for the value after a build. Rotating one is a
# dashboard edit plus a redeploy; it does not require rebuilding the app.
# =============================================================================


# -----------------------------------------------------------------------------
# Analytics - optional. Unset = no script, no dataLayer, no requests at all.
# -----------------------------------------------------------------------------
# Google Analytics 4 measurement ID. Must match G-XXXXXXXXXX or it is ignored
# with a build-time warning.
# Owner: client (Analytics account)     Rotation: REBUILD REQUIRED
PUBLIC_GA4_ID=

# Google Tag Manager container ID. Must match GTM-XXXXXXX or it is ignored
# with a build-time warning. Only needed if the client uses GTM in addition to
# (or instead of) direct GA4.
# Owner: client (GTM account)           Rotation: REBUILD REQUIRED
PUBLIC_GTM_ID=


# -----------------------------------------------------------------------------
# Cloudflare Turnstile - optional bot protection on the lead endpoints.
#
# SET BOTH OR NEITHER. The site key renders the challenge; the secret verifies
# it server-side. Setting only the secret rejects every real submission (the
# server fails closed); setting only the site key renders a challenge nobody
# checks. There is intentionally no built-in test/sandbox key.
# -----------------------------------------------------------------------------
# Owner: dev (Cloudflare)               Rotation: REBUILD REQUIRED (PUBLIC_)
PUBLIC_TURNSTILE_SITE_KEY=

# Owner: dev (Cloudflare)               Rotation: dashboard + redeploy
TURNSTILE_SECRET=


# -----------------------------------------------------------------------------
# Lead delivery - NOT YET IMPLEMENTED.
#
# Both /api/contact and /api/chat-lead currently validate a lead and log it,
# then return success. Until delivery is wired, no lead reaches the client.
# The variables below are the expected shape, not live configuration.
# -----------------------------------------------------------------------------
# Where verified leads should be POSTed (Zapier / Make / CRM endpoint).
# Owner: client                         Rotation: dashboard + redeploy
# LEAD_WEBHOOK_URL=

# Shared secret used to sign the outgoing webhook payload, if the receiver
# supports signature verification.
# Owner: dev                            Rotation: dashboard + redeploy
# LEAD_WEBHOOK_SECRET=

# Transactional email delivery for lead notifications.
# Owner: client                         Rotation: dashboard + redeploy
# RESEND_API_KEY=
# LEAD_TO_EMAIL=
