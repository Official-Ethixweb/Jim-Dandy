---
import { business } from "@data/site";
import { CalendarClock, Phone } from "lucide-react";
---

<div
  id="sticky-cta"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full p-3 transition-transform duration-300 ease-brand lg:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  aria-hidden="true"
  inert
>
  <div class="pointer-events-auto mx-auto flex max-w-md items-center gap-3 rounded-2xl border border-white/10 bg-navy-900/95 p-2 shadow-2xl backdrop-blur-md">
    <a
      href={business.phoneHref}
      class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-white/10 px-4 py-3 font-display text-[21px] font-normal leading-none text-white"
    >
      <Phone className="h-4 w-4 text-brand-green-400" aria-hidden="true" />
      Call Now
    </a>
    <a
      href={business.scheduleUrl}
      class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-[image:var(--btn-primary)] px-4 py-3 font-display text-[21px] font-normal leading-none text-navy-900 shadow-[var(--shadow-btn-green)] hover:bg-[image:var(--btn-primary-hover)] hover:shadow-[var(--shadow-btn-green-hover)]"
    >
      <CalendarClock className="h-4 w-4" aria-hidden="true" />
      Schedule
    </a>
  </div>
</div>

<script>
  function initStickyCta() {
    const bar = document.getElementById("sticky-cta");
    if (!bar) return;
    const onScroll = () => {
      const show = window.scrollY > 520;
      bar.classList.toggle("translate-y-full", !show);
      bar.setAttribute("aria-hidden", show ? "false" : "true");
      // aria-hidden alone left both links in the tab order while the bar was
      // off-screen; inert removes them from focus and the accessibility tree.
      bar.inert = !show;
      // The chat and accessibility launchers are fixed in the same corners this
      // bar occupies, and at 375px they covered the left edge of "Call Now" and
      // half of "Schedule". Publish the bar's height so they can step above it.
      const lift = show ? `${Math.round(bar.getBoundingClientRect().height)}px` : "0px";
      document.documentElement.style.setProperty("--sticky-cta-lift", lift);
    };
    // Reserved once, not per scroll event: toggling page padding as the bar
    // shows and hides would shift the page under the reader's finger.
    const reserve = () => {
      const h = Math.round(bar.getBoundingClientRect().height) || 87;
      document.documentElement.style.setProperty("--sticky-cta-reserve", `${h + 12}px`);
    };
    reserve();
    window.addEventListener("resize", reserve, { passive: true });

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  if (document.readyState !== "loading") initStickyCta();
  else document.addEventListener("DOMContentLoaded", initStickyCta);
</script>
