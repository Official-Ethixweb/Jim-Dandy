---
import AnimatedCounter from "@components/ui/AnimatedCounter";
import { business, serviceAreaCities } from "@data/site";

type Stat = { target: number; decimals?: number; suffix?: string; label: string };

type Props = {
  stats?: Stat[];
  tone?: "navy" | "light";
};

const {
  stats = [
    { target: business.yearsInBusiness, label: "Years in Business" },
    { target: business.rating.value, decimals: 1, suffix: "/ 5", label: "Google Rating" },
    // Total Google reviews (the 4.8 average means not every one is 5 stars).
    { target: business.rating.count, suffix: "+", label: "Google Reviews" },
    { target: serviceAreaCities.length, suffix: "+", label: "Cities Served" },
  ],
  tone = "navy",
} = Astro.props;

const isNavy = tone === "navy";
---

<section class:list={["relative overflow-hidden", isNavy ? "bg-navy-900" : "bg-white"]}>
  {isNavy && (
    <div
      class="pointer-events-none absolute inset-0 opacity-50"
      style="background: radial-gradient(700px circle at 50% 120%, rgba(105,190,40,0.18), transparent 60%);"
      aria-hidden="true"
    ></div>
  )}
  <div class="container-page relative py-14 lg:py-16">
    <dl class="grid grid-cols-2 gap-y-10 gap-x-4 lg:grid-cols-4" data-reveal-group data-reveal-step="70">
      {stats.map((stat, i) => (
        <div class:list={["flex flex-col-reverse items-center justify-end gap-1.5 px-4 text-center", i > 0 && "lg:border-l", isNavy ? "lg:border-white/10" : "lg:border-navy-100"]}>
          {/* dt before dd for screen readers; flex-col-reverse keeps the number on top. */}
          <dt class:list={["text-sm font-bold uppercase leading-snug tracking-[0.12em]", isNavy ? "text-white/75" : "text-navy-500"]}>
            {stat.label}
          </dt>
          <dd class:list={["flex items-baseline font-badge text-4xl font-bold sm:text-[44px]", isNavy ? "text-white" : "text-navy-800"]}>
            <AnimatedCounter client:visible target={stat.target} decimals={stat.decimals ?? 0} />
            {/* "/ 5" gets a space ("4.8 / 5"); "+" hugs its number ("177+"). */}
            {stat.suffix && <span class:list={["text-brand-green-400", stat.suffix.startsWith("/") && "ml-2"]}>{stat.suffix}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
