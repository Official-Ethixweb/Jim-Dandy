---
import SectionHeading from "@components/ui/SectionHeading.astro";
import ContactPanel from "./ContactPanel";
---

<section id="contact" class="bg-navy-800 py-20 lg:py-28">
  <div class="container-page flex flex-col gap-8">
    <SectionHeading title="Get in Touch Today" subtitle="Tell us what you need - a real dispatcher will call or text you back, usually the same day." light />

    <div class="rounded-[45px] border-2 border-brand-green-500 bg-white p-6 shadow-xl sm:p-8 lg:p-8">
      <ContactPanel client:idle />
    </div>
  </div>
</section>
