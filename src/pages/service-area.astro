---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Button from "@components/ui/Button.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import ServiceArea from "@components/sections/ServiceArea";
import FinalCta from "@components/sections/FinalCta.astro";
import MotionInit from "@components/ui/MotionInit.astro";
import StickyCta from "@components/ui/StickyCta.astro";
import { business, serviceAreaCities, serviceCounties } from "@data/site";
import { breadcrumbSchema } from "@lib/seo";
import { ChevronRight, MapPin, Phone } from "lucide-react";
import QuickLeadForm from "@components/sections/QuickLeadForm";
import skyline from "@assets/photos/seattle-skyline.webp";

const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Service Area", path: "/service-area" },
]);
---

<Layout
  title="Plumber in Seattle, Bellevue & Puget Sound | Jim Dandy"
  description="Same-day licensed plumbers across King, Snohomish, and Pierce Counties - Seattle, Bellevue, Everett, Tacoma, and 12 more Puget Sound cities."
  path="/service-area"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} slot="head" />

  <!-- Skyline hero -->
  <section class="relative isolate overflow-hidden bg-navy-900">
    {/* Phones: the hero is tall (it holds the form), so the skyline covers only
        its top and fades out - stretched over the full height it was blown up
        ~5x and soft. Desktop keeps it full-bleed. */}
    <Image
      src={skyline}
      alt=""
      widths={[768, 1280, 1920, 2500]}
      sizes="(min-width: 1024px) 100vw, 1100px"
      quality={82}
      loading="eager"
      class="absolute inset-x-0 top-0 -z-10 h-[560px] w-full object-cover [mask-image:linear-gradient(to_bottom,black_55%,transparent)] lg:inset-0 lg:h-full lg:[mask-image:none]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-900 via-navy-900/85 to-navy-900/55" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-50"
      style="background: radial-gradient(620px circle at 12% 20%, rgba(105,190,40,0.20), transparent 60%);"
      aria-hidden="true"
    ></div>

    {/* Phones read title -> form -> details; desktop puts the form in the
        right column across both rows (same layout as PageHero with a form). */}
    <div class="container-page relative grid grid-cols-1 gap-y-8 py-20 lg:grid-cols-[1.1fr_minmax(0,0.9fr)] lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:gap-y-6 lg:py-24">
      <div class="flex flex-col items-start gap-6 lg:col-start-1 lg:row-start-1 lg:self-end">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-white/60">
        <a href="/" class="-my-2.5 inline-flex min-h-11 items-center hover:text-white">Home</a>
        <ChevronRight className="h-3.5 w-3.5 text-white/35" aria-hidden="true" />
        <span class="text-white">Service Area</span>
      </nav>
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-green-500/40 bg-brand-green-500/10 px-4 py-1.5 font-sans text-xs font-bold uppercase tracking-[0.18em] text-brand-green-400">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-green-400"></span>
        Same-Day Dispatch
      </span>
      <h1 class="max-w-3xl text-balance font-display text-[38px] font-black italic leading-[1.03] text-cloud sm:text-[52px] lg:text-[58px]">
        Proudly Serving the Puget Sound Region
      </h1>
      </div>

      <div id="quick-quote" class="w-full scroll-mt-28 lg:col-start-2 lg:max-w-xl lg:row-span-2 lg:row-start-1 lg:self-center lg:justify-self-end">
        <QuickLeadForm client:idle />
      </div>

      <div class="flex flex-col items-start gap-6 lg:col-start-1 lg:row-start-2 lg:self-start">
      <p class="max-w-xl text-lg leading-relaxed text-white/80">
        Licensed plumbers dispatched same-day across King, Snohomish, and Pierce Counties - with 24/7
        emergency response in every community we cover.
      </p>
      <div class="mt-1 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
        <Button href={business.phoneHref} variant="secondary">Call {business.phone}</Button>
      </div>
      </div>
    </div>
  </section>

  <!-- Interactive coverage -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page">
      <ServiceArea client:idle linkToPage={false} />
    </div>
  </section>

  <!-- Counties -->
  <section class="bg-surface py-20 lg:py-28">
    <div class="container-page flex flex-col gap-14">
      <div data-reveal>
        <SectionHeading eyebrow="Coverage" title="Three Counties, One Team" subtitle="From the North Sound to the South Sound, help is close by." />
      </div>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3" data-reveal-group>
        {serviceCounties.map((county) => (
          <div class="group flex flex-col gap-4 rounded-[28px] border border-navy-200 bg-white p-8 shadow-sm transition-all duration-300 ease-brand hover:-translate-y-1.5 hover:border-navy-800 hover:shadow-card">
            <span class="grid h-14 w-14 place-items-center rounded-2xl icon-chip transition-all duration-300 group-hover:icon-chip-green">
              <MapPin className="h-7 w-7" strokeWidth={1.6} aria-hidden="true" />
            </span>
            <h3 class="font-display text-2xl font-bold text-navy-800">{county.name}</h3>
            <p class="text-sm leading-relaxed text-navy-600">{county.cities}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cities grid -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page flex flex-col gap-14">
      <div data-reveal>
        <SectionHeading title="Cities We Serve" subtitle="Licensed plumbers dispatched same-day - with 24/7 emergency response - in every city below." />
      </div>
      {/* Cities in an even grid on desktop (it was 3 columns with one city
          left alone on the last row, and the same sentence repeated 16 times). */}
      <ul class="flex flex-wrap justify-center gap-3 sm:gap-4" data-reveal-group data-reveal-step="30">
        {serviceAreaCities.map((city) => {
          const slug = city.toLowerCase().replace(/\s+/g, "-");
          return (
            <li id={slug} class="w-[calc(50%-0.375rem)] scroll-mt-28 sm:w-[calc(33.333%-0.667rem)] lg:w-[calc(25%-0.75rem)] xl:w-[calc(20%-0.8rem)]">
              {/* The whole tile calls dispatch - one big, obvious tap target. */}
              <a
                href={business.phoneHref}
                aria-label={`Call Jim Dandy for plumbing in ${city}: ${business.phone}`}
                class="group flex h-full flex-col gap-2 rounded-[20px] border border-navy-200 bg-surface p-4 transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-brand-green-500 hover:bg-white hover:shadow-card sm:p-5"
              >
                <span class="flex items-center gap-2.5">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl icon-chip transition-all duration-300 group-hover:icon-chip-green">
                    <MapPin className="h-5 w-5" aria-hidden="true" />
                  </span>
                  <h3 class="font-display text-xl font-bold leading-tight text-navy-800 sm:text-[22px]">{city}</h3>
                </span>
                <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-brand-green-600 group-hover:text-navy-800 sm:text-base">
                  <Phone className="h-4 w-4 shrink-0" aria-hidden="true" />
                  <span class="sm:hidden">Tap to call</span>
                  <span class="max-sm:hidden">{business.phone}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <FinalCta />

  <StickyCta />
  <MotionInit />
</Layout>
