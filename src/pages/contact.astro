---
import Layout from "@layouts/Layout.astro";
import Button from "@components/ui/Button.astro";
import PageHero from "@components/sections/PageHero.astro";
import MotionInit from "@components/ui/MotionInit.astro";
import StickyCta from "@components/ui/StickyCta.astro";
import ProcessSteps from "@components/sections/ProcessSteps.astro";
import { business } from "@data/site";
import { breadcrumbSchema } from "@lib/seo";
import { ArrowRight, Clock, Mail, MapPin, Phone } from "lucide-react";

const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact" },
]);

const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.address.full)}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(business.address.full)}&z=13&output=embed`;

const nextSteps = [
  { title: "We Call You Back", description: "A real dispatcher calls or texts you - usually within the hour during business hours, right away for emergencies." },
  { title: "Upfront Price, No Surprises", description: "A licensed technician diagnoses the problem and gives you a flat price before any work starts." },
  { title: "Fixed Right, Guaranteed", description: "We do the work cleanly, explain what we did, and stand behind it with our workmanship guarantee." },
];

const contactCards = [
  { icon: Phone, label: "Call or Text", value: business.phone, href: business.phoneHref, note: "24/7 live dispatch" },
  { icon: Mail, label: "Email", value: business.email, href: `mailto:${business.email}`, note: "We reply within one business day" },
  { icon: MapPin, label: "Visit", value: business.address.full, href: directionsUrl, note: "Mountlake Terrace, WA" },
  { icon: Clock, label: "Hours", value: business.hours, href: undefined, note: "Emergencies answered anytime" },
];
---

<Layout
  title="Contact Jim Dandy | 24/7 Seattle Plumber"
  description="Reach Jim Dandy Sewer & Plumbing 24/7 by phone, or schedule online. Serving the Puget Sound region from Mountlake Terrace, WA."
  path="/contact"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} slot="head" />

  <PageHero
    eyebrow="We're Standing By"
    title="Let's Get It Fixed"
    lead="Call anytime for emergencies, or send us the details and a dispatcher will reach out to confirm your appointment - usually the same day."
    crumbs={[{ name: "Home", href: "/" }, { name: "Contact" }]}
    leadForm
    leadFormStyle="chips"
    highlights={[
      "A real dispatcher answers - 24/7",
      "Upfront flat price before any work",
      "Licensed, bonded & insured in WA",
      `Seattle's plumber since ${business.founded}`,
    ]}
  />

  <ProcessSteps
    eyebrow="No Surprises"
    title="What Happens After You Send It"
    subtitle="Three simple steps between your request and a problem solved."
    steps={nextSteps}
    tone="surface"
  />

  <!-- Contact details + map -->
  <section class="bg-white py-20 lg:py-28">
    {/* Heading spans both columns, so the cards and the map start on the same
        line; the map then stretches to end exactly where the cards end. */}
    <div class="container-page flex flex-col gap-3" data-reveal>
      <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-brand-green-600">Ways to Reach Us</span>
      <h2 class="font-heading text-3xl font-bold text-navy-800 sm:text-4xl">One Call Away, Day or Night</h2>
    </div>
    <div class="container-page mt-8 grid grid-cols-1 items-stretch gap-8 lg:mt-10 lg:grid-cols-2 lg:gap-10">
      <div class="flex flex-col gap-6" data-reveal="left">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {contactCards.map(({ icon: Icon, label, value, href, note }) => {
            const Tag = href ? "a" : "div";
            return (
              <Tag
                href={href}
                class="group flex flex-col gap-3 rounded-[24px] border border-navy-200 bg-surface p-6 transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-brand-green-500 hover:bg-white hover:shadow-card"
              >
                <span class="grid h-12 w-12 place-items-center rounded-xl icon-chip transition-all duration-300 group-hover:icon-chip-green">
                  <Icon className="h-5 w-5" aria-hidden="true" />
                </span>
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-navy-400">{label}</p>
                  <p class="mt-1 font-semibold leading-snug text-navy-800 [overflow-wrap:normal] break-words">
                    {/* Emails break after the @, never mid-word. */}
                    {label === "Email" ? (
                      <>{value.split("@")[0]}<wbr />@{value.split("@")[1]}</>
                    ) : (
                      value
                    )}
                  </p>
                  <p class="mt-1 text-xs text-navy-500">{note}</p>
                </div>
              </Tag>
            );
          })}
        </div>
        <div class="flex flex-col gap-4 rounded-[24px] border border-brand-green-500/30 bg-brand-green-50 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-lg font-bold text-navy-800">Plumbing emergency right now?</p>
            <p class="text-sm text-navy-600">A real dispatcher answers 24/7 - don't wait.</p>
          </div>
          <Button href={business.phoneHref} variant="primary" size="md" class="shrink-0">Call {business.phone}</Button>
        </div>
      </div>

      <div class="flex flex-col overflow-hidden rounded-[28px] border border-navy-200 bg-surface shadow-card" data-reveal="right">
        <iframe
          title={`Map showing ${business.name} in Mountlake Terrace, WA`}
          src={mapEmbedUrl}
          width="100%"
          class="block min-h-[320px] w-full flex-1 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-14 items-center justify-between gap-3 border-t border-navy-200 bg-white px-5 py-3 text-base font-semibold text-navy-800 transition-colors hover:bg-brand-green-50"
        >
          <span class="inline-flex items-center gap-2">
            <MapPin className="h-5 w-5 text-brand-green-600" aria-hidden="true" />
            Get driving directions
          </span>
          <ArrowRight className="h-5 w-5 text-brand-green-600" aria-hidden="true" />
          <span class="sr-only">(opens Google Maps in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <StickyCta />
  <MotionInit />
</Layout>
