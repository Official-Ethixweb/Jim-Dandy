---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/sections/PageHero.astro";
import FinalCta from "@components/sections/FinalCta.astro";
import StickyCta from "@components/ui/StickyCta.astro";
import MotionInit from "@components/ui/MotionInit.astro";
import { breadcrumbSchema } from "@lib/seo";
import { ArrowUpRight, Clock } from "lucide-react";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const fmt = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const minutes = (body = "") => Math.max(2, Math.round(body.split(/\s+/).length / 220));

const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Plumbing Tips", path: "/blog" },
]);
---

<Layout
  title="Plumbing Tips & Advice for Seattle Homes | Jim Dandy Blog"
  description="Practical plumbing advice from Seattle's plumbers since 1908 - water heaters, sewer lines, drains, winter pipe care, and what to do in an emergency."
  path="/blog"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} slot="head" />

  <PageHero
    leadForm
    eyebrow="Tips From Our Pros"
    title="Plumbing Tips & Advice"
    lead="Straight answers from a crew that has fixed Puget Sound plumbing since 1908 - what to watch for, what you can do yourself, and when to call."
    crumbs={[{ name: "Home", href: "/" }, { name: "Plumbing Tips" }]}
  />

  <section class="bg-surface py-20 lg:py-28">
    <div class="container-page">
      <ul class="flex flex-wrap justify-center gap-6" data-reveal-group>
        {posts.map((post) => (
          <li class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            <a
              href={`/blog/${post.id}`}
              class="group flex h-full flex-col gap-4 rounded-[26px] border border-navy-200 bg-white p-7 shadow-sm transition-all duration-300 ease-brand hover:-translate-y-1.5 hover:border-brand-green-500 hover:shadow-card"
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
                <span class="rounded-full bg-brand-green-50 px-3.5 py-1.5 font-semibold text-brand-green-600">{post.data.category}</span>
                <span class="inline-flex items-center gap-1.5 text-navy-500">
                  <Clock className="h-4 w-4" aria-hidden="true" />
                  {minutes(post.body)} min read
                </span>
              </div>
              <h2 class="font-display text-[24px] font-bold leading-tight text-navy-800">{post.data.title}</h2>
              <p class="line-clamp-3 flex-1 text-base leading-relaxed text-navy-600">{post.data.description}</p>
              <div class="flex items-center justify-between border-t border-navy-100 pt-4">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-navy-500">{fmt.format(post.data.pubDate)}</time>
                <span class="inline-flex items-center gap-1 font-semibold text-navy-800 group-hover:text-brand-green-600">
                  Read article <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCta />
  <StickyCta />
  <MotionInit />
</Layout>
